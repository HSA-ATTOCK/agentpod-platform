# Copy to .env.local and fill in. Never commit real values.

# Anthropic API key (Claude Console → API keys). Server-only.
ANTHROPIC_API_KEY=

# Filled in automatically by `npm run baba:setup`
BABA_AGENT_ID=
BABA_ENVIRONMENT_ID=

# Agent setup profile: "test" = cheapest (Claude Haiku 5.5, low effort) for development,
# anything else = normal (Claude Sonnet 5.5). Run `npm run baba:setup` after changing it.
BABA_PROFILE=test

# Spending caps are set per workspace in the app: Settings → AI & spending

# Baba's API routes are OFF in production (next start / Vercel) unless this is true.
# Everyone who signs up can then use your API credit (within their spending limits).
# BABA_ALLOW_PUBLIC=true

# --- Supabase (database + sign-in) ---
# Supabase dashboard → Project Settings → API. Both are safe in the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Email (Gmail + Nodemailer) ---
# Invites and task notifications. Leave empty to skip emails.
# GMAIL_APP_PASSWORD: Google Account → Security → 2-Step Verification on → App passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Baba

# Your app's public address, used in email links and the sitemap (e.g. https://baba.example.com)
NEXT_PUBLIC_SITE_URL=
# Only if NEXT_PUBLIC_SITE_URL can't be set and a trusted proxy sets x-forwarded-host (production)
# TRUST_FORWARDED_HOST=1

# --- Scheduled workflows ---
# Supabase dashboard → Project Settings → API Keys → Secret key (server only, never in the browser).
# Needed so workflows can run on schedule while nobody is signed in.
SUPABASE_SECRET_KEY=
# The app checks for due workflows every minute while it's running. If you use an external
# scheduler instead (Vercel Cron / Supabase pg_cron calling /api/cron/workflows), set:
# BABA_SCHEDULER=off
# CRON_SECRET=a-long-random-string

# --- Google (Gmail, Drive, Calendar) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URI: https://<your app address>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: key used to encrypt stored tokens (defaults to one derived from SUPABASE_SECRET_KEY)
# INTEGRATIONS_ENCRYPTION_KEY=

# Where the public contact form sends messages (defaults to GMAIL_USER).
# CONTACT_EMAIL=hello@yourcompany.com

# ---- Payments (Stripe; optional) ----
# Without these, plans are assigned by the platform admin and there's no online payment.
# 1) Stripe → Developers → API keys → Secret key.
# 2) Create a Product + recurring Price per plan; paste each Price ID into Admin → Plans.
# 3) Developers → Webhooks → endpoint https://<your-domain>/api/billing/webhook with events:
#    checkout.session.completed, customer.subscription.created, customer.subscription.updated,
#    customer.subscription.deleted, invoice.payment_failed. Copy its signing secret below.
# 4) Settings → Billing → Customer portal: turn on "switch plans" and cancellation.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Live websites on your own domain (AWS; optional) ----
# Created by infrastructure/terraform (see docs/DEPLOYMENT_GUIDE.md). Without these, websites stay on preview links.
# AWS_REGION=eu-west-2
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# SITES_S3_BUCKET=baba-sites-...
# SITES_CLOUDFRONT_DISTRIBUTION_ID=E123...
# SITES_PUBLIC_DOMAIN=sites.example.com

# ---- Search by meaning for the knowledge base (optional) ----
# Set ONE of these (keyword search works without them). EMBEDDINGS_PROVIDER picks one if both are set.
# OPENAI_API_KEY=sk-...
# VOYAGE_API_KEY=pa-...
# EMBEDDINGS_PROVIDER=voyage

# ---- Other AI providers for custom agents (optional) ----
# Allow models and set their prices in Admin -> Settings -> Other AI models.
# OPENAI_API_KEY is shared with search by meaning.
# GEMINI_API_KEY=...
# SITES_OAC_ID=E2ABC...   (CloudFront origin access control, from Terraform; needed for customers' own domains)
