# Copy to .env.local and fill in. Never commit real values.

# Anthropic API key (Claude Console → API keys). Server-only.
ANTHROPIC_API_KEY=

# Filled in automatically by `npm run baba:setup`
BABA_AGENT_ID=
BABA_ENVIRONMENT_ID=

# Agent setup profile: "test" = cheapest (Claude Haiku 5.5, low effort) for development,
# anything else = normal (Claude Sonnet 5.5). Run `npm run baba:setup` after changing it.
BABA_PROFILE=test

# Spending caps are set per workspace in the app: Settings → AI & spending

# Baba's API routes are OFF in production (next start / Vercel) unless this is true.
# Everyone who signs up can then use your API credit (within their spending limits).
# BABA_ALLOW_PUBLIC=true

# --- Supabase (database + sign-in) ---
# Supabase dashboard → Project Settings → API. Both are safe in the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Email (Gmail + Nodemailer) ---
# Invites and task notifications. Leave empty to skip emails.
# GMAIL_APP_PASSWORD: Google Account → Security → 2-Step Verification on → App passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Baba

# Your app's public address, used in email links and the sitemap (e.g. https://baba.example.com)
NEXT_PUBLIC_SITE_URL=
