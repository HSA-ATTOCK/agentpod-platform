# Copy to .env.local and fill in. Never commit real values.

# Anthropic API key (Claude Console → API keys). Server-only.
ANTHROPIC_API_KEY=

# Filled in automatically by `npm run baba:setup`
BABA_AGENT_ID=
BABA_ENVIRONMENT_ID=

# Agent setup profile: "test" = cheapest (Claude Haiku 5.5, low effort) for development,
# anything else = normal (Claude Sonnet 5.5). Run `npm run baba:setup` after changing it.
BABA_PROFILE=test

# Spending cap per Ask Baba conversation, in US dollars (default 1)
BABA_SESSION_BUDGET_USD=1

# Baba's API routes are OFF in production until login exists.
# Only set this to true if you understand anyone with the URL can use your API credit.
# BABA_ALLOW_PUBLIC=true

# --- Supabase (database + sign-in) ---
# Supabase dashboard → Project Settings → API. Both are safe in the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
